# Пути к данным
DATA_PATH=datasets/Credit Risk Data.csv
KAGGLE_DATASET=alexdister/credit-risk-dataset
MODEL_DIR=models
MODEL_FILENAME=lgbm_final_model.pkl

# Настройки обучения
TARGET_COLUMN=loan_status
TEST_SIZE=0.2
RANDOM_STATE=42
CV_FOLDS=5
N_TRIALS=50
INCLUDE_WEAK=false
USE_OPTUNA=false

# Настройки API
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
API_LOG_LEVEL=info

# Настройки логирования
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S